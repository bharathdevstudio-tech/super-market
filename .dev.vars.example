# Local development secrets for `wrangler dev`.
#
# Lives at the REPOSITORY ROOT, next to wrangler.toml, because Wrangler reads
# `.dev.vars` from the directory that contains the config file it loaded.
#
# Copy this file to `.dev.vars` (which is git-ignored) and fill in real values.
# Never commit `.dev.vars`.
#
# In production these are set with:
#   npx wrangler secret put TOKEN_SECRET
#
# Generate a secret locally, e.g.:
#   node -e "console.log(crypto.randomBytes(32).toString('base64'))"

# Signing key for API tokens (HMAC-SHA256). Rotating it logs everyone out.
TOKEN_SECRET=replace-me-with-a-long-random-value

# Optional overrides (defaults live in wrangler.toml [vars])
# TOKEN_TTL_SECONDS=28800
