{
  "name": "bharath-supermarket-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker API for Bharath SuperMarket (D1 backend).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply bharath-supermarket --local",
    "db:migrate:remote": "wrangler d1 migrations apply bharath-supermarket --remote",
    "test": "node ../tests/api.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^3.99.0"
  }
}
